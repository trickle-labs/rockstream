diff --git a/crates/rockstream-ops/src/group_commit/physical.rs b/crates/rockstream-ops/src/group_commit/physical.rs
--- a/crates/rockstream-ops/src/group_commit/physical.rs
+++ b/crates/rockstream-ops/src/group_commit/physical.rs
@@ -67,6 +67,12 @@
     max_epochs: usize,
 }
 
+impl Drop for Inner {
+    fn drop(&mut self) {
+        self.notify.notify_one();
+    }
+}
+
 /// Coherent fill observations. Retained quantities include in-flight and retry
 /// storage, not just the visible pending map.
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
@@ -221,6 +227,7 @@
         state.retained_epochs += 1;
         state.retained_operations = proposed_operations;
-        state.force_flush |= proposed == self.inner.max_bytes || state.retained_epochs == self.inner.max_epochs;
+        let force_flush = proposed == self.inner.max_bytes || state.retained_epochs == self.inner.max_epochs;
+        state.force_flush |= force_flush;
         drop(state);
         self.ensure_driver();
         self.inner.notify.notify_one();
