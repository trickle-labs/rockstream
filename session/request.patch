@@ -0,0 +1,119 @@
+//! Worker progress for empty multisets must still be backed by a durable epoch.
+use rockstream_runtime::client::{execute_frame, setup_test_deployment};
+use rockstream_runtime::epoch_compaction::EpochCompactionConfig;
+use rockstream_storage::ShardKeyEncoder;
+use rockstream_types::data_plane::{
+    RuntimeExchangeMessage, RuntimeRow, DEPLOYMENT_DESCRIPTOR_VERSION,
+};
+use rockstream_types::ids::{LeaseToken, OperatorId, ShardId, WorkloadId};
+use rockstream_types::topology::WorkerMessage;
+
+fn frame(epoch: u64) -> RuntimeExchangeMessage {
+    RuntimeExchangeMessage {
+        version: DEPLOYMENT_DESCRIPTOR_VERSION,
+        request_id: format!("empty-{epoch}"),
+        workload_id: WorkloadId(1),
+        shard_id: ShardId(100),
+        operator_id: OperatorId(10),
+        lease_token: LeaseToken(777),
+        epoch,
+        source: "items".into(),
+        rows: vec![
+            RuntimeRow {
+                values_tsv: "9\tunchanged".into(),
+                weight: 1,
+            },
+            RuntimeRow {
+                values_tsv: "9\tunchanged".into(),
+                weight: -1,
+            },
+        ],
+    }
+}
+
+#[tokio::test]
+async fn zero_net_epoch_has_a_real_committed_frontier_before_progress() {
+    let dir = tempfile::tempdir().unwrap();
+    let (client, deployments, db, _, mut progress) =
+        setup_test_deployment(dir.path(), EpochCompactionConfig::default()).await;
+    execute_frame(&client, &deployments, frame(9))
+        .await
+        .unwrap();
+    let deployment = deployments
+        .read()
+        .get(&(WorkloadId(1), ShardId(100)))
+        .unwrap()
+        .clone();
+    assert_eq!(deployment.commit_group.committed_epoch(), Some(9));
+    assert_eq!(
+        db.get(&ShardKeyEncoder::frontier_key())
+            .await
+            .unwrap()
+            .map(|b| b.to_vec()),
+        Some(9u64.to_be_bytes().to_vec())
+    );
+    match progress.recv().await.unwrap() {
+        WorkerMessage::ExecutionProgress {
+            output,
+            input_rows,
+            output_rows,
+        } => {
+            assert_eq!(
+                (
+                    output.request_id,
+                    output.epoch,
+                    output.rows,
+                    input_rows,
+                    output_rows
+                ),
+                ("empty-9".into(), 9, vec![], 2, 0)
+            );
+        }
+        other => panic!("unexpected progress: {other:?}"),
+    }
+    assert_eq!(
+        rockstream_ops::sink::read_view_output(&db, OperatorId(10), 2)
+            .await
+            .unwrap(),
+        vec![]
+    );
+}
+
+#[tokio::test]
+async fn failed_empty_epoch_flush_never_acknowledges_progress() {
+    let dir = tempfile::tempdir().unwrap();
+    let (client, deployments, db, _, mut progress) =
+        setup_test_deployment(dir.path(), EpochCompactionConfig::default()).await;
+    db.set_fail_flushes(true);
+    let result = execute_frame(&client, &deployments, frame(10)).await;
+    assert!(result.is_err());
+    let deployment = deployments
+        .read()
+        .get(&(WorkloadId(1), ShardId(100)))
+        .unwrap()
+        .clone();
+    assert_eq!(deployment.commit_group.committed_epoch(), None);
+    assert_eq!(
+        progress.try_recv().unwrap_err(),
+        tokio::sync::mpsc::error::TryRecvError::Empty
+    );
+    let fill = deployment.commit_group.fill();
+    assert_eq!(
+        (
+            fill.retained_epochs,
+            fill.active_waiters,
+            fill.retry_required,
+            fill.outcome_unknown
+        ),
+        (1, 0, true, true)
+    );
+    db.set_fail_flushes(false);
+    assert_eq!(deployment.commit_group.flush().await.unwrap(), vec![10]);
+    assert_eq!(deployment.commit_group.committed_epoch(), Some(10));
+    assert_eq!(deployment.commit_group.fill().retained_epochs, 0);
+    // The failed caller is not retrospectively sent a successful response.
+    assert_eq!(
+        progress.try_recv().unwrap_err(),
+        tokio::sync::mpsc::error::TryRecvError::Empty
+    );
+}
