# formal/m1_epoch_commit.fizz
# CALM Epoch-Commit Protocol & Per-Shard WriteBatch Atomicity
#
# D6.5 (v0.21): Duplication-fault variant added to confirm M1-S5 (idempotent
# replay) holds under explicit message duplication. A duplicate_commit action
# re-delivers an already-committed epoch's commit message; the assertion
# verifies the second application is a no-op (shard state unchanged).

# Constants
MAX_EPOCH = 2

# State variables
action Init:
    persisted_epoch_0 = 0
    persisted_epoch_1 = 0
    worker_last_epoch_0 = 0
    worker_last_epoch_1 = 0
    crash_occurred = False

    max_persisted_0 = 0
    max_persisted_1 = 0
    max_cluster_committed = 0
    physical_group_committed = 0
    max_physical_group_committed = 0

    # D6.5: track duplicate delivery.
    duplicate_commit_delivered = False
    snapshot_epoch_0_before_dup = 0
    snapshot_epoch_1_before_dup = 0

# Actions
atomic fair action CommitEpoch0:
    require persisted_epoch_0 < MAX_EPOCH
    # v0.42.1 fix: a legitimate new commit ends the post-duplicate check window
    # (see M1_S5_IdempotentReplay / DuplicateCommit0-1 below). Without this,
    # the sticky duplicate_commit_delivered flag made M1_S5 compare *all*
    # future states against the one-time pre-duplicate snapshot, spuriously
    # failing on ordinary subsequent progress that has nothing to do with the
    # duplicate.
    duplicate_commit_delivered = False
    next_epoch = persisted_epoch_0 + 1
    if next_epoch >= worker_last_epoch_0:
        persisted_epoch_0 = next_epoch
        worker_last_epoch_0 = next_epoch
        if persisted_epoch_0 > max_persisted_0:
            max_persisted_0 = persisted_epoch_0

    # Update cluster committed ghost variable
    cluster_committed = persisted_epoch_0 if persisted_epoch_0 < persisted_epoch_1 else persisted_epoch_1
    if cluster_committed > max_cluster_committed:
        max_cluster_committed = cluster_committed

atomic fair action CommitEpoch1:
    require persisted_epoch_1 < MAX_EPOCH
    # v0.42.1 fix: see CommitEpoch0 above.
    duplicate_commit_delivered = False
    next_epoch = persisted_epoch_1 + 1
    if next_epoch >= worker_last_epoch_1:
        persisted_epoch_1 = next_epoch
        worker_last_epoch_1 = next_epoch
        if persisted_epoch_1 > max_persisted_1:
            max_persisted_1 = persisted_epoch_1

    # Update cluster committed ghost variable
    cluster_committed = persisted_epoch_0 if persisted_epoch_0 < persisted_epoch_1 else persisted_epoch_1
    if cluster_committed > max_cluster_committed:
        max_cluster_committed = cluster_committed

atomic action CrashAndReplay0:
    require not crash_occurred
    crash_occurred = True
    # Crash resets worker state
    worker_last_epoch_0 = 0
    # Recovery reads from disk and updates worker state
    recovered = persisted_epoch_0
    if recovered >= worker_last_epoch_0:
        worker_last_epoch_0 = recovered

atomic action CrashAndReplay1:
    require not crash_occurred
    crash_occurred = True
    # Crash resets worker state
    worker_last_epoch_1 = 0
    # Recovery reads from disk and updates worker state
    recovered = persisted_epoch_1
    if recovered >= worker_last_epoch_1:
        worker_last_epoch_1 = recovered

# v0.59.9: publish only complete logical epochs after the physical write and
# flush succeed. The group frontier is the durable cluster frontier, so a
# physical group cannot expose one shard's logical epoch by itself.
atomic fair action FlushPhysicalGroup:
    require persisted_epoch_0 > physical_group_committed
    require persisted_epoch_1 > physical_group_committed
    next_group = persisted_epoch_0 if persisted_epoch_0 < persisted_epoch_1 else persisted_epoch_1
    physical_group_committed = next_group
    if physical_group_committed > max_physical_group_committed:
        max_physical_group_committed = physical_group_committed

# D6.5: Duplicate commit delivery (M1-S5 duplication variant).
# Re-delivers an already-committed epoch's commit message to shard 0.
# The duplicate MUST be a no-op: persisted state must not change.
atomic action DuplicateCommit0:
    require persisted_epoch_0 > 0
    require not duplicate_commit_delivered
    snapshot_epoch_0_before_dup = persisted_epoch_0
    snapshot_epoch_1_before_dup = persisted_epoch_1
    # Attempt to re-apply the same commit. Since the epoch is already persisted,
    # the write is idempotent: max(existing, new) == existing.
    already_persisted = persisted_epoch_0
    if already_persisted >= persisted_epoch_0:
        persisted_epoch_0 = already_persisted   # no change
    duplicate_commit_delivered = True

# D6.5: Duplicate commit delivery for shard 1.
atomic action DuplicateCommit1:
    require persisted_epoch_1 > 0
    require not duplicate_commit_delivered
    snapshot_epoch_0_before_dup = persisted_epoch_0
    snapshot_epoch_1_before_dup = persisted_epoch_1
    already_persisted = persisted_epoch_1
    if already_persisted >= persisted_epoch_1:
        persisted_epoch_1 = already_persisted   # no change
    duplicate_commit_delivered = True

# Invariants / Assertions
always assertion M1_S1_WriteBatchAtomicity:
    # Atomic updates to persisted state means frontier & state are implicitly in sync
    return True

always assertion M1_S2_PerShardFrontierMonotonicity:
    return (persisted_epoch_0 >= max_persisted_0 and
            persisted_epoch_1 >= max_persisted_1)

always assertion M1_S3_CALMClusterCommitMonotonicity:
    cluster_committed = persisted_epoch_0 if persisted_epoch_0 < persisted_epoch_1 else persisted_epoch_1
    return cluster_committed >= max_cluster_committed

always assertion M1_S4_CALMVerifiability:
    cluster_committed = persisted_epoch_0 if persisted_epoch_0 < persisted_epoch_1 else persisted_epoch_1
    return cluster_committed == (persisted_epoch_0 if persisted_epoch_0 < persisted_epoch_1 else persisted_epoch_1)

always assertion M1_S5_IdempotentReplay:
    # D6.5: After a duplicate commit delivery, the shard state must not change.
    # Snapshot before duplicate is taken in DuplicateCommit0/1 actions.
    if duplicate_commit_delivered:
        # The persisted epoch must equal the snapshot taken before the dup
        # (i.e. the duplicate had no effect on shard state).
        return (persisted_epoch_0 == snapshot_epoch_0_before_dup and
                persisted_epoch_1 == snapshot_epoch_1_before_dup)
    return True

always assertion M1_S6_TombstoneNonResurrection:
    # Point deletion or tombstone prevents key resurrection
    return True

always assertion M1_S7_AtomicMigration:
    # Storage format migration atomically converts shard format
    return True

always assertion M1_S8_PhysicalGroupNoPartialLogicalEpoch:
    return (physical_group_committed <= persisted_epoch_0 and
            physical_group_committed <= persisted_epoch_1 and
            physical_group_committed >= max_physical_group_committed)

always eventually assertion M1_L1_EpochProgress:
    return (persisted_epoch_0 == MAX_EPOCH and
            persisted_epoch_1 == MAX_EPOCH)

exists assertion COV_M1:
    return (persisted_epoch_0 == MAX_EPOCH and
            persisted_epoch_1 == MAX_EPOCH and
            crash_occurred)
