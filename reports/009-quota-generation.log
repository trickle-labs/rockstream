+// The final operator owner must not leave a charge in its shared workload.
+impl Drop for StateBudget {
+    fn drop(&mut self) {
+        if let Some(ref wl) = self.workload_budget {
+            wl.release(*self.current_bytes.get_mut());
+        }
+    }
+}
