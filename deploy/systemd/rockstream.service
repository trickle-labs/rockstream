[Unit]
Description=RockStream Incremental View Maintenance Engine (Standalone)
Documentation=https://github.com/trickle-labs/rockstream https://rockstream.dev
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=rockstream
Group=rockstream
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/rockstream start --role=all --listen=0.0.0.0:5432 --metrics-addr=0.0.0.0:9090 --storage=/var/lib/rockstream
Restart=on-failure
RestartSec=5s

# Security Hardening & Sandboxing Directives
StateDirectory=rockstream
LogsDirectory=rockstream
RuntimeDirectory=rockstream
WorkingDirectory=/var/lib/rockstream
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Resource Limits
LimitNOFILE=65536
LimitNPROC=32768
LimitMEMLOCK=infinity

# Healthcheck & Watchdog
WatchdogSec=30
TimeoutStopSec=35s

[Install]
WantedBy=multi-user.target
