[Unit]
Description=RockStream Stateful Stream Processing Worker
Documentation=https://github.com/trickle-labs/rockstream
After=network-online.target rockstream-control.service local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=rockstream
Group=rockstream
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/rockstream start --role=worker --control=http://127.0.0.1:9200 --listen=0.0.0.0:9100 --metrics-addr=0.0.0.0:9090 --storage=/var/lib/rockstream-worker
Restart=on-failure
RestartSec=5s

# Security Hardening & Sandboxing Directives
StateDirectory=rockstream-worker
LogsDirectory=rockstream-worker
RuntimeDirectory=rockstream-worker
WorkingDirectory=/var/lib/rockstream-worker
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Resource Limits
LimitNOFILE=65536
LimitNPROC=32768
LimitMEMLOCK=infinity

# Healthcheck & Watchdog
WatchdogSec=30
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
