+pub async fn preprovision_limited_identity(storage_dir: &std::path::Path, pki: &TestPki) {
+    use rockstream_storage::catalog::{
+        CatalogMutation, CatalogStore, CatalogTxn, DurableCatalogStore,
+    };
+    use rockstream_types::ids::PrincipalId;
+    use sha2::{Digest, Sha256};
+    let store = std::sync::Arc::new(
+        object_store::local::LocalFileSystem::new_with_prefix(storage_dir.join("gateway-shard"))
+            .unwrap(),
+    );
+    let catalog = DurableCatalogStore::recover(store, "gateway")
+        .await
+        .unwrap();
+    let certs = rustls_pemfile::certs(&mut std::io::BufReader::new(
+        std::fs::File::open(&pki.limited_cli_cert_path).unwrap(),
+    ))
+    .collect::<Result<Vec<_>, _>>()
+    .unwrap();
+    let mut principal = catalog.list_security_principals().await.unwrap().remove(0);
+    principal.id = PrincipalId(2);
+    principal.display_name = "management test limited".to_owned();
+    principal.login_methods = vec![LoginMethod::Mtls {
+        certificate_sha256: Sha256::digest(certs[0].as_ref()).into(),
+    }];
+    principal.preset_grants.clear();
+    let mut audit = catalog
+        .list_security_audit_records()
+        .await
+        .unwrap()
+        .remove(0);
+    audit.event_id = "management-test-limited-bootstrap".to_owned();
+    audit.actor = AuditIdentity::Verified("principal:1".to_owned());
+    audit.target = AuditField::Known("principal:2".to_owned());
+    audit.operation_id = AuditField::Known("2".to_owned());
+    audit.after_state = AuditField::Known(format!(
+        "revision=1;policy={}",
+        serde_json::to_string(&(true, &principal.preset_grants, &principal.scoped_grants)).unwrap()
+    ));
+    catalog
+        .commit_txn(
+            CatalogTxn::new(
+                2,
+                2,
+                vec![CatalogMutation::PutSecurityPrincipal {
+                    principal,
+                    expected_revision: None,
+                    grantor_revision: Some((PrincipalId(1), 1)),
+                    audit,
+                }],
+            )
+            .unwrap(),
+        )
+        .await
+        .unwrap();
+}
+
