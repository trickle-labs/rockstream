{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R1 raw sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "pair_id", "order", "candidate_id", "binary_sha256", "profile_sha256", "corpus_sha256", "thresholds_sha256", "workload", "strategy", "worker_count", "seed", "change_stream_sha256", "monotonic_duration_ns", "accepted_changes", "visible_changes", "freshness_histogram", "processes", "logical_bytes", "lfs_bytes", "exchange_bytes", "max_queue_depth", "operator_counters", "workers", "canonical_input_sha256", "rockstream_output_sha256", "sqlite_oracle_output_sha256", "outputs_equal"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "order": {"enum": ["a_then_b", "b_then_a"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "thresholds_sha256": {"$ref": "#/$defs/sha256"},
    "workload": {"type": "string", "minLength": 1},
    "strategy": {"type": "string", "minLength": 1},
    "worker_count": {"type": "integer", "minimum": 0},
    "seed": {"type": "integer", "minimum": 0},
    "change_stream_sha256": {"$ref": "#/$defs/sha256"},
    "monotonic_duration_ns": {"type": "integer", "exclusiveMinimum": 0},
    "accepted_changes": {"type": "integer", "minimum": 1},
    "visible_changes": {"type": "integer", "minimum": 1},
    "freshness_histogram": {"$ref": "#/$defs/freshness_histogram"},
    "processes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/process"}},
    "logical_bytes": {"type": "integer", "minimum": 0},
    "lfs_bytes": {"type": "integer", "minimum": 0},
    "exchange_bytes": {"type": "integer", "minimum": 0},
    "max_queue_depth": {"type": "integer", "minimum": 0},
    "operator_counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "workers": {"type": "array", "items": {"$ref": "#/$defs/worker"}},
    "canonical_input_sha256": {"$ref": "#/$defs/sha256"},
    "rockstream_output_sha256": {"$ref": "#/$defs/sha256"},
    "sqlite_oracle_output_sha256": {"$ref": "#/$defs/sha256"},
    "outputs_equal": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freshness_histogram": {"type": "object", "additionalProperties": false, "required": ["upper_bounds_ms", "counts"], "properties": {"upper_bounds_ms": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}},
    "process": {"type": "object", "additionalProperties": false, "required": ["role", "pid", "user_cpu_ns", "system_cpu_ns", "rss_bytes"], "properties": {"role": {"type": "string"}, "pid": {"type": "integer", "minimum": 1}, "user_cpu_ns": {"type": "integer", "minimum": 0}, "system_cpu_ns": {"type": "integer", "minimum": 0}, "rss_bytes": {"type": "integer", "minimum": 0}}},
    "worker": {"type": "object", "additionalProperties": false, "required": ["worker_id", "pid", "shards_owned", "input_rows", "output_rows", "state_writes", "exchange_bytes"], "properties": {"worker_id": {"type": "integer", "minimum": 1}, "pid": {"type": "integer", "minimum": 1}, "shards_owned": {"type": "integer", "minimum": 1}, "input_rows": {"type": "integer", "minimum": 1}, "output_rows": {"type": "integer", "minimum": 1}, "state_writes": {"type": "integer", "minimum": 0}, "exchange_bytes": {"type": "integer", "minimum": 0}}}
  }
}
